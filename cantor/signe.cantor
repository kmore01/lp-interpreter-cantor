# signe.cantor
main signe

import anterior

# aparella_amb_anterior(x) = <x, anterior(x)>
define aparella_amb_anterior
    [Aparella x amb el seu predecessor]
    pair id anterior

# signe(x) = max(0, x - anterior(x))
define signe
    [Signe: 0 per 0, 1 per la resta]
    comp diff aparella_amb_anterior

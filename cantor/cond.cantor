# cond.cantor
main cond
import booleans
import relacionals

# Entrada: <p.<a.b>> on p es el predicat, a i b son les opcions

define p_val
    [p = fst(z)]
    fst

define a_val
    [a = fst(snd(z))]
    comp fst snd

define b_val
    [b = snd(snd(z))]
    comp snd snd

define signe_p
    [signe(p) = 0 si p=0, 1 si p>0]
    comp signe p_val

define no_signe_p
    [1 - signe(p)]
    comp not signe_p

define aparella_signe_a
    [<signe(p). a>]
    pair signe_p a_val

define term_a
    [signe(p) * a]
    comp mul aparella_signe_a

define aparella_no_b
    [<not(signe(p)). b>]
    pair no_signe_p b_val

define term_b
    [not(signe(p)) * b]
    comp mul aparella_no_b

define aparella_terms
    [<term_a. term_b>]
    pair term_a term_b

define cond
    [if p then a else b = signe(p)*a + (1-signe(p))*b]
    comp add aparella_terms
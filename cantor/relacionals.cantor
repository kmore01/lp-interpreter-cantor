# relacionals.cantor
main neq

import booleans
import signe

define swap
    [<x.y> -> <y.x>]
    pair snd fst

define diff_swap
    [diff(y - x)]
    comp diff swap

define aparella_diff
    [<diff(x-y).diff(y-x)>]
    pair diff diff_swap

define suma_diff
    [diff(x-y) + diff(y-x)]
    comp add aparella_diff

define gt
    [1 si x > y, 0 altrament]
    comp signe diff

define lt
    [1 si x < y, 0 altrament]
    comp gt swap


define neq
    [1 si x != y, 0 altrament]
    comp signe suma_diff

define eq
    [1 si x == y, 0 altrament]
    comp not neq
# fibonacci.cantor
main fib
extended
import relacionals

define k_0
    [0]
    compair diff k_1 k_1

define k_2
    [2]
    compair add k_1 k_1

define is_base
    [es 0 o 1? (lt(i, 2))]
    compair lt id k_2

define fib_g
    [<fib(i).fib(i-1)> per cas base = <i.0>]
    pair id k_0

define fib_i
    [fib(i) = fib(i-1)+fib(i-2) = add(state anterior)]
    comp add fst

define fib_prev
    [fib(i-1) = fst(state anterior)]
    comp fst fst

define fib_step
    [pas: <fib(i).fib(i-1)>]
    pair fib_i fib_prev

define fib_state
    [<fib(x).fib(x-1)>]
    primrec is_base fib_g fib_step

define fib
    [Fibonacci(x)]
    comp fst fib_state
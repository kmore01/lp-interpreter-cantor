# booleans.cantor
main not

define aparella_not
    [Aparella 1 amb x: <1.x>]
    pair k_1 id

define not
    [NOT: 1 - x]
    comp diff aparella_not

define and
    [AND: x * y]
    comp mul id

define aparella_1
    [Aparella x amb 1: <x.1>]
    pair id k_1

define ant
    [Anterior amb limit 0]
    comp diff aparella_1

define aparella_ant
    [Aparella x amb ant(x)]
    pair id ant

define signe
    [Signe: 0 -> 0, resta -> 1]
    comp diff aparella_ant

define or
    [OR: 0 nomes si x=0 i y=0]
    comp signe add

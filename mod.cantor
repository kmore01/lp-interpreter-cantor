# mod.cantor
main mod

define k_0
    [0]
    compair diff k_1 k_1

define ant
    [max(0, x-1)]
    compair diff id k_1

define signe
    [0 si x=0, 1 altrament]
    compair diff id ant

define gt
    [1 si x > y, 0 altrament]
    comp signe diff

define vx
    [x a <<x.y>.q>]
    comp fst fst

define vy
    [y a <<x.y>.q>]
    comp snd fst

define q1
    [q+1 a <<x.y>.q>]
    compair add snd k_1

define yq1
    [y*(q+1) a <<x.y>.q>]
    compair mul vy q1

define test_quotient
    [y*(q+1) > x a <<x.y>.q>]
    compair gt yq1 vx

define quot
    [x // y]
    mu test_quotient

define q
    [quotient de <x.y>]
    quot

define yq
    [y * q]
    compair mul snd q

# mod(<x.y>) = diff(<x. y*q>) = x - y*(x//y) = x mod y
define mod
    [x mod y]
    compair diff fst yq

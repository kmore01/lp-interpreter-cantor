# max2.cantor
main max2
import cond

# aparella_gt_id(z) = <gt(z). z> = <p. <a.b>> on p = gt(<x.y>), a = x, b = y
define aparella_gt_id
    [<gt(z). z>]
    pair gt id

# max2(<x.y>) = cond(gt(<x.y>), x, y) = max(x, y)
define max2
    [maxim de x i y usant cond]
    comp cond aparella_gt_id

# swap(z) = <y.x>
define swap
    [<y.x>]
    pair snd fst

# aparella_min_id(z) = <diff(z). swap(z)> = <p. <b.a>> on p = diff(x,y)
define aparella_min_id
    [<diff(z). <y.x>>]
    pair diff swap

# min2(<x.y>) = cond(diff(x,y), y, x) = min(x, y)
define min2
    [minim de x i y usant cond]
    comp cond aparella_min_id
